# ============================================
# DATABASE (apps/db, packages/prisma)
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hfm-db
DB_PORT=5433
DB_CONTAINER_NAME=hfm-db

# Prisma connection string (auto-constructed from DB_* variables)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# ============================================
# BACKEND APIs
# ============================================
# API Port
API_PORT=3001


# ============================================
# FRONTEND APPS
# ============================================
# API URL for Web to call API (used by lib/fetch/* and providers)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public site URL (no trailing slash). Used for canonical URLs and hreflang.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Site / brand name for Open Graph (`og:site_name`). Omit if you do not want it set.
NEXT_PUBLIC_SITE_NAME="HF Markets"

# ============================================
# GENERAL
# ============================================
# Node environment
NODE_ENV=development

# Set to `production` for production-like behavior (e.g. post-build robots.txt with sitemap).
# APP_ENV=production
